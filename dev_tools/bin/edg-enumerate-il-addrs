# Script to enumerate addresses in --il_display output.  Invoked as a filter
# (i.e., reads from stdin, outputs to stdout).
# Replaces entity-name@01234567 -> entity-name#1
#
{ s = $0;
  while (i = match(s, /[a-z][a-z-]+[a-z]@[0-9a-f]+/)) {
    m = substr(s, RSTART, RLENGTH);
    kind = substr(m, 1, index(m, "@") - 1);
    if (!(m in map)) map[m] = ++count[kind];
    gsub(m, kind "#" map[m], s);
  }
  print s
}
