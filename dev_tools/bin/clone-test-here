import argparse

import edgtest

from pathlib import Path

def parse_args() -> argparse.Namespace:
  parser = argparse.ArgumentParser(
    description = 'Clone test files to current working directory.'
  )
  parser.add_argument(
    'test',
    type = Path,
    help = 'the test file path'
  )
  return parser.parse_args()

def main() -> None:
  args = parse_args()

  edgtest.sync_checkout_at_directory(args.test, Path.cwd())

main()
