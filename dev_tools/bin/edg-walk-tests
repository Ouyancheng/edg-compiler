import argparse
import os

import edgtest

from pathlib import Path

from edgtest import runtest

def parse_args():
  parser = argparse.ArgumentParser(
    description = (
      'EDG tool walking tests in a directory (typically output is fed to '
      'xargs for consumption by some other tool).'
    )
  )
  parser.add_argument(
    '--extension',
    dest = 'extensions',
    default = [],
    action = 'append',
    help = 'add an alternative extension to use for test files'
  )
  parser.add_argument(
    '--kind',
    dest = 'path_kind',
    choices = ['test', 'assoc-file-dir', 'recording-dir'],
    default = 'test',
    help = 'the path to print for each test'
  )
  parser.add_argument(
    'directory',
    nargs = '?',
    default = Path(os.getcwd()),
    type = Path,
    help = 'the directory to walk'
  )
  return parser.parse_args()

def main() -> None:
  args = parse_args()

  directory = args.directory
  extensions = (
    args.extensions if len(args.extensions) > 0
    else edgtest.DEFAULT_TEST_EXTENSIONS
  )

  for test_path in edgtest.walk_test_directory(directory, extensions):
    path_kind = args.path_kind
    if path_kind == 'test':
      printed_path = test_path
    else:
      if path_kind == 'assoc-file-dir':
        opt_assoc_files_dir = runtest.get_assoc_files_path(test_path)
        if opt_assoc_files_dir is None:
          continue
        printed_path = opt_assoc_files_dir
      elif path_kind == 'recording-dir':
        printed_path = runtest.get_assoc_recordings_path(test_path)
      if not printed_path.exists():
        continue
    print(str(printed_path.relative_to(directory)))

main()
