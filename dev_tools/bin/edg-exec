import argparse

import edgdocker

from pathlib import Path, PurePosixPath
from tempfile import NamedTemporaryFile

CMD_DESCRIPTION = f"""
EDG development environment task launcher.

This tool is used to launch a standardized docker development environment
(by default {edgdocker.DEFAULT_IMAGE}). As an example, consider:

  edg-exec bash

This will provide a bash shell inside of the standardized development
environment.

This command can also accept n arguments to execute inside the launched
container. For instance, in the top level of a checkout of the front end, the
following will generate the CMake configuration for a Clang based build, then
build it using ninja:

  edg-exec -- "cmake --preset linux-clang-debug"
  edg-exec -- "cd build/clang && ninja"

Alternatively, the --wdir flag can be used in this example to avoid using bash
to manipulate the working directory:

  edg-exec -- cmake --preset linux-clang-debug
  edg-exec --wdir build/clang -- ninja

Alternative environments can be launched using the --img flag. For instance,
to run the build command in a legacy environment:

  edg-exec --img legacy-dev-env -- cmake --preset linux-clang-debug
  edg-exec --img legacy-dev-env --wdir build/clang -- ninja

-----------------------------------------------------------------------------
"""

def parse_args():
  parser = argparse.ArgumentParser(
    description = CMD_DESCRIPTION,
    formatter_class = argparse.RawDescriptionHelpFormatter
  )
  parser.add_argument(
    '--platform',
    dest = 'platform_specifier',
    default = 'linux/amd64',
    help = 'the expected platform for the image'
  )
  parser.add_argument(
    '--img',
    dest = 'image_name',
    default = edgdocker.DEFAULT_IMAGE,
    choices = edgdocker.EXECUTABLE_IMAGES,
    help = 'the image to use'
  )
  parser.add_argument(
    '--wdir',
    dest = 'working_dir',
    default = '',
    type = PurePosixPath,
    help = (
      'the working directory inside of the container to launch into '
      '(unless an absolute path is specified, this is relative '
      'to "/edg/workspace")'
    )
  )
  parser.add_argument(
    '--memory',
    dest = 'memory_limit',
    default = '',
    help = 'the memory limit for the container, e.g. 10g (none by default)'
  )
  parser.add_argument(
    '--x11',
    dest = 'enable_x11',
    action = 'store_true',
    help = 'enable mapping of X11 from the container to the host system'
  )
  parser.add_argument(
    '--core-dumps',
    dest = 'enable_core_dumps',
    action = 'store_true',
    help = 'enable core dumps within the container'
  )
  parser.add_argument(
    '--dry-run',
    dest = 'dry_run',
    action = 'store_true',
    help = 'echo the command rthat would have been run, but don\'t run it'
  )
  parser.add_argument(
    '--verbose',
    dest = 'verbose',
    action = 'store_true',
    help = 'enable verbose mode'
  )
  parser.add_argument(
    'arguments',
    nargs='*',
    default = ['bash'],
    help = 'the command arguments to forward'
  )
  return parser.parse_args()

def _resolve_working_directory(args: argparse.Namespace) -> PurePosixPath:
  working_dir = args.working_dir
  if not str(working_dir).startswith('/'):
    working_dir = PurePosixPath('/edg/workspace/', working_dir)
  return working_dir

def main() -> None:
  edgdocker.terminate_if_running_in_docker()

  args = parse_args()

  workspace_dir = Path.cwd()
  command_string = ' '.join(args.arguments)
  container_working_dir = _resolve_working_directory(args)

  edgdocker.exec_docker_cmd(
    args.image_name,
    workspace_dir,
    container_working_dir,
    command_string,
    enable_x11 = args.enable_x11,
    platform_specifier = args.platform_specifier,
    enable_core_dumps = args.enable_core_dumps,
    memory_limit = args.memory_limit,
    dry_run = args.dry_run,
    verbose = args.verbose
  )

main()
