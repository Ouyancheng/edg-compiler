import argparse
import tempfile

import edgtest

from pathlib import Path

def parse_args() -> argparse.Namespace:
  parser = argparse.ArgumentParser(
    description = 'Clone test files to a temporary directory.'
  )
  parser.add_argument(
    'test',
    type = Path,
    help = 'the test file path'
  )
  return parser.parse_args()

def main() -> None:
  args = parse_args()

  tmp_dir = Path(tempfile.mkdtemp(
    prefix = f"tstcln.{args.test.stem}.",
    dir = Path.cwd()
  ))
  edgtest.sync_checkout_at_directory(args.test, tmp_dir)
  print(str(tmp_dir.resolve()))

main()
