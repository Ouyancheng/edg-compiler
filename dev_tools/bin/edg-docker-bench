import argparse
import json
import os
import shlex
import subprocess
import sys
import tempfile
import uuid

import edgacknowledg
import edgbench
import edgdocker
import edgutil

from typing import Any, Dict, List, Optional
from pathlib import Path, PurePosixPath

from edgutil import eprint

TOOL_PATH_EDG_EXEC = edgutil.RequiredToolPath('edg-exec')

BUILTIN_POSTURES = [
  'release',
  'release-c',
  'release-cpp'
]

def parse_args() -> argparse.Namespace:
  parser = argparse.ArgumentParser(
    description = (
      'EDG utility script that captures common docker hybrid '
      'benchmark workflows.'
    )
  )
  parser.add_argument(
    '--posture',
    dest = 'posture',
    default = 'release',
    help = (
      'run benchmarks in docker with one of the builtin postures '
      f"{{{', '.join(BUILTIN_POSTURES)}}}"
    )
  )
  parser.add_argument(
    '-j',
    '--jobs',
    dest = 'job_count',
    default = None,
    type = int,
    help = 'the number of concurrent edg-bench jobs'
  )
  parser.add_argument(
    '--non-interactive',
    dest = 'non_interactive',
    action = 'store_true',
    help = 'do not launch AcknowlEDG review'
  )
  parser.add_argument(
    '--dry-run',
    dest = 'dry_run',
    action = 'store_true',
    help = 'do not run the docker commands'
  )
  parser.add_argument(
    '--verbose',
    dest = 'verbose',
    action = 'store_true',
    help = 'enable verbose mode'
  )
  return parser.parse_args()

class BenchInvocation:
  '''One edg-bench run of a binary, compared against a named baseline.'''

  def __init__(self, *, binary: str, baseline: str,
               section_name: str) -> None:
    self.binary = binary
    self.baseline = baseline
    self.section_name = section_name
    self.run_timestamp: Optional[str] = None

class BenchRunPostureBuild:
  def __init__(self, *, cmake_preset: str, build_path: str,
               targets: List[str], edg_base: str,
               bench_runs: List[BenchInvocation]) -> None:
    self.cmake_preset = cmake_preset
    self.build_path = build_path
    self.targets = targets
    self.edg_base = PurePosixPath(edg_base)
    self.bench_runs = bench_runs

class BenchRunPosture:
  def __init__(self, *, builds: List[BenchRunPostureBuild],
               job_count: Optional[int],
               acknowledg_ui_host: Optional[str],
               acknowledg_api_host: Optional[str]) -> None:
    self.builds = builds
    self.job_count = job_count
    self.acknowledg_ui_host = acknowledg_ui_host
    self.acknowledg_api_host = acknowledg_api_host

def _make_release_posture(
    args: argparse.Namespace, *,
    targets: List[str],
    bench_runs: List[BenchInvocation]) -> BenchRunPosture:
  return BenchRunPosture(
    builds = [
      BenchRunPostureBuild(
        cmake_preset = 'linux-gcc-release',
        build_path = 'build/gcc-release',
        targets = targets,
        edg_base = edgdocker.DEFAULT_EDG_BASE,
        bench_runs = bench_runs
      )
    ],
    job_count = args.job_count,
    acknowledg_ui_host = os.environ.get('EDG_ACKNOWLEDG_UI_HOST'),
    acknowledg_api_host = os.environ.get('EDG_ACKNOWLEDG_API_HOST')
  )

def _configure_release_posture(args: argparse.Namespace) -> BenchRunPosture:
  return _make_release_posture(
    args,
    targets = ['cpfe', 'cpfe-cp'],
    bench_runs = [
      BenchInvocation(
        binary = 'bin/cpfe',
        baseline = 'release',
        section_name = 'C'
      ),
      BenchInvocation(
        binary = 'bin/cpfe-cp',
        baseline = 'release-cpp',
        section_name = 'C++'
      )
    ]
  )

def _configure_release_c_posture(args: argparse.Namespace) -> BenchRunPosture:
  return _make_release_posture(
    args,
    targets = ['cpfe'],
    bench_runs = [
      BenchInvocation(
        binary = 'bin/cpfe',
        baseline = 'release-c',
        section_name = 'C'
      )
    ]
  )

def _configure_release_cpp_posture(
                                  args: argparse.Namespace) -> BenchRunPosture:
  return _make_release_posture(
    args,
    targets = ['cpfe-cp'],
    bench_runs = [
      BenchInvocation(
        binary = 'bin/cpfe-cp',
        baseline = 'release-cpp',
        section_name = 'C++'
      )
    ]
  )

def _configure_base_posture(args: argparse.Namespace) -> BenchRunPosture:
  if args.posture == 'release':
    return _configure_release_posture(args)
  if args.posture == 'release-c':
    return _configure_release_c_posture(args)
  if args.posture == 'release-cpp':
    return _configure_release_cpp_posture(args)
  eprint(f"No builtin mode named: {args.posture}")
  sys.exit(1)

def _configure_posture(args: argparse.Namespace) -> BenchRunPosture:
  posture = _configure_base_posture(args)
  if args.non_interactive:
    posture.acknowledg_api_host = None
    posture.acknowledg_ui_host = None
  return posture

def _apply_tty_fix(cmd_str: str) -> str:
  # There are some quirks in how docker maps stdin, stdout, and stderr.  There
  # may be a way to fix this in edg-exec.  However, for the sake of fixing this
  # now, pipe the command through cat so the terminal commands know they're not
  # really in a tty.
  tty_fix = '' if sys.stdout.isatty() else ' | cat'
  return f"{cmd_str}{tty_fix}"

def _build_posture_env(posture: BenchRunPosture) -> Dict[str, str]:
  env_cpy = dict(os.environ)
  if 'EDG_DOCKER_HOST_PATHS' not in env_cpy:
    env_cpy['EDG_DOCKER_HOST_PATHS'] = '1'
  return env_cpy

def _build_bench_env(src_dir: Path, posture: BenchRunPosture,
                     posture_build: BenchRunPostureBuild) -> Dict[str, str]:
  env_cpy = _build_posture_env(posture)
  env_cpy['EDG_BASE'] = str(src_dir.joinpath(posture_build.edg_base))
  return env_cpy

def configure_build(src_dir: Path, posture: BenchRunPosture, *,
                    dry_run: bool, verbose: bool) -> None:
  for build in posture.builds:
    if (src_dir / build.build_path).exists():
      continue

    print(f"Configuring build ({build.cmake_preset})...", flush = True)

    configure_cmd = f"cmake --preset {build.cmake_preset}"
    cmd_args = [
      str(TOOL_PATH_EDG_EXEC),
      '--',
      _apply_tty_fix(configure_cmd)
    ]
    if dry_run or verbose:
      print(' '.join(cmd_args), flush = True)
    if not dry_run:
      env_ovr = _build_bench_env(src_dir, posture, build)
      build_process = subprocess.run(
        cmd_args,
        stdout = sys.stdout,
        stderr = sys.stderr,
        cwd = src_dir,
        env = env_ovr
      )
      if build_process.returncode != 0:
        sys.exit(10)

def update_build(src_dir: Path, posture: BenchRunPosture, *,
                 dry_run: bool, verbose: bool) -> None:
  for build in posture.builds:
    print(f"Updating build ({build.cmake_preset})...", flush = True)
    build_cmd = f"cmake --build {build.build_path}"
    if build.targets != ['all']:
      for target in build.targets:
        build_cmd += f" --target={shlex.quote(target)}"
    if verbose:
      build_cmd = f"{build_cmd} --verbose"
    cmd_args = [
      str(TOOL_PATH_EDG_EXEC),
      '--',
      _apply_tty_fix(build_cmd)
    ]
    if dry_run or verbose:
      print(' '.join(cmd_args), flush = True)
    if not dry_run:
      env_ovr = _build_bench_env(src_dir, posture, build)
      build_process = subprocess.run(
        cmd_args,
        stdout = sys.stdout,
        stderr = sys.stderr,
        cwd = src_dir,
        env = env_ovr
      )
      if build_process.returncode != 0:
        sys.exit(11)

def _latest_bench_run_timestamp(src_dir: Path) -> str:
  bench_home = src_dir / 'benchmarks'
  run_dirs = edgbench.get_benchmark_runs(bench_home)
  if len(run_dirs) == 0:
    eprint('edg-bench completed but no benchmark run directory was found.')
    sys.exit(20)
  return run_dirs[0].name

def _build_edg_bench_cmd(posture: BenchRunPosture, binary: str, *,
                         verbose: bool) -> str:
  arg_str = 'edg-bench'
  if posture.job_count is not None:
    arg_str += f" -j {posture.job_count}"
  if verbose:
    arg_str += ' --verbose'
  arg_str += f" {shlex.quote(binary)}"
  return arg_str

def run_benchmarks(src_dir: Path, posture: BenchRunPosture, *,
                   dry_run: bool, verbose: bool) -> int:
  for build in posture.builds:
    for bench_run in build.bench_runs:
      print(
        f"Running edg-bench ({bench_run.binary}, baseline "
        f"{bench_run.baseline})...",
        flush = True
      )
      bench_cmd = (
        'source environment.sh && '
        f"{_build_edg_bench_cmd(posture, bench_run.binary, verbose = verbose)}"
      )
      cmd_args = [
        str(TOOL_PATH_EDG_EXEC),
        '--wdir',
        build.build_path,
        '--',
        _apply_tty_fix(bench_cmd)
      ]
      if dry_run or verbose:
        print(' '.join(cmd_args), flush = True)
      if dry_run:
        bench_run.run_timestamp = '<timestamp>'
        continue

      env_ovr = _build_bench_env(src_dir, posture, build)
      bench_process = subprocess.run(
        cmd_args,
        stdout = sys.stdout,
        stderr = sys.stderr,
        cwd = src_dir,
        env = env_ovr
      )
      if bench_process.returncode != 0:
        return bench_process.returncode
      bench_run.run_timestamp = _latest_bench_run_timestamp(src_dir)

  return 0

def _is_posture_acknowledg_enabled(posture: BenchRunPosture) -> bool:
  return bool(posture.acknowledg_ui_host and posture.acknowledg_api_host)

def _build_batch_spec(posture: BenchRunPosture, review_id: str,
                      review_name: str, created_at: str) -> Dict[str, Any]:
  sections: List[Dict[str, Any]] = []
  for build in posture.builds:
    for bench_run in build.bench_runs:
      assert bench_run.run_timestamp is not None
      root = (
        f"/edg/workspace/benchmarks/runs/{bench_run.run_timestamp}"
      )
      slug = edgacknowledg.section_slug(bench_run.section_name)
      parameters = {
        'root': root,
        'tag': bench_run.baseline
      }
      sections.append({
        'name': bench_run.section_name,
        'slug': slug,
        'type': 'bench.src',
        'parameters': parameters
      })
      sections.append({
        'name': bench_run.section_name,
        'slug': slug,
        'type': 'bench.edit',
        'parameters': dict(parameters)
      })

  return {
    'reviews': [
      {
        'id': review_id,
        'name': review_name,
        'timestamp': created_at,
        'sections': sections
      }
    ]
  }

def _acknowledg_cli_host_args(posture: BenchRunPosture) -> str:
  assert posture.acknowledg_api_host is not None
  assert posture.acknowledg_ui_host is not None
  return (
    f"--api-host={shlex.quote(posture.acknowledg_api_host)} "
    f"--ui-host={shlex.quote(posture.acknowledg_ui_host)}"
  )

def run_acknowledg(src_dir: Path, posture: BenchRunPosture, *,
                   dry_run: bool, verbose: bool) -> None:
  print('Opening AcknowlEDG...', flush = True)
  review_id = str(uuid.uuid4())
  review_name = edgacknowledg.review_display_name()
  created_at = edgacknowledg.utc_now_iso()
  batch_spec = _build_batch_spec(
    posture,
    review_id,
    review_name,
    created_at
  )

  containing_tmp_dir = src_dir / '.tmp'
  containing_tmp_dir.mkdir(parents = True, exist_ok = True)
  with tempfile.TemporaryDirectory(dir = containing_tmp_dir) as tmp_dir_str:
    tmp_dir = Path(tmp_dir_str)
    spec_file = tmp_dir / 'batch-spec.json'
    with open(spec_file, 'w') as file_handle:
      json.dump(batch_spec, file_handle, indent = '  ')
      file_handle.write('\n')

    docker_spec_file = spec_file.relative_to(src_dir).as_posix()
    if dry_run or verbose:
      print(f"Wrote batch specification ({docker_spec_file}):", flush = True)
      with open(spec_file) as file_handle:
        for line in file_handle:
          print(f"  {line}", end = '')
      print('', flush = True)

    cli_cmd = (
      'edg-acknowledg-cli '
      f"{_acknowledg_cli_host_args(posture)} "
      f"{shlex.quote('/edg/workspace/' + docker_spec_file)}"
    )
    cmd_args = [
      str(TOOL_PATH_EDG_EXEC),
      '--',
      _apply_tty_fix(cli_cmd)
    ]

    if dry_run or verbose:
      print(' '.join(cmd_args), flush = True)

    if not dry_run:
      env_ovr = _build_posture_env(posture)
      acknowledg_process = subprocess.run(
        cmd_args,
        stdout = sys.stdout,
        stderr = sys.stderr,
        cwd = src_dir,
        env = env_ovr
      )
      if acknowledg_process.returncode != 0:
        sys.exit(1)

class Serializer(json.JSONEncoder):
  def default(self, obj: Any) -> Any:
    if isinstance(obj, BenchRunPosture):
      return vars(obj)
    if isinstance(obj, BenchRunPostureBuild):
      return vars(obj)
    if isinstance(obj, BenchInvocation):
      return vars(obj)
    if isinstance(obj, PurePosixPath):
      return str(obj)
    return json.JSONEncoder.default(self, obj)

def main() -> None:
  edgdocker.terminate_if_running_in_docker()

  args = parse_args()

  TOOL_PATH_EDG_EXEC.exit_if_not_found()

  src_dir = edgutil.find_mono_repo_or_exit()

  if args.verbose:
    print(f"Using front end source in: {src_dir}", flush = True)

  edgdocker.ensure_edg_docker_image_present(edgdocker.DEFAULT_IMAGE)

  run_posture = _configure_posture(args)
  if args.dry_run or args.verbose:
    config_str = json.dumps(
      vars(run_posture),
      cls = Serializer,
      indent = '  '
    )
    print(f"Using configuration:\n{config_str}", flush = True)

  configure_build(
    src_dir,
    run_posture,
    dry_run = args.dry_run,
    verbose = args.verbose
  )
  update_build(
    src_dir,
    run_posture,
    dry_run = args.dry_run,
    verbose = args.verbose
  )
  bench_exit_code = run_benchmarks(
    src_dir,
    run_posture,
    dry_run = args.dry_run,
    verbose = args.verbose
  )

  if (
    bench_exit_code == 0 and
    _is_posture_acknowledg_enabled(run_posture)
  ):
    run_acknowledg(
      src_dir,
      run_posture,
      dry_run = args.dry_run,
      verbose = args.verbose
    )

  sys.exit(0 if bench_exit_code == 0 else 20)

main()
