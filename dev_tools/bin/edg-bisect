import argparse

import edgutil

from edgshell.bisect import (
  BisectInProgressException,
  MonoRepoBisector,
  NoBisectException
)

def _bisect_start(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.start(args.bad_commit, args.good_commit)

def _add_parse_start(subparsers):
  parser = subparsers.add_parser(
    'start',
    help = 'start the git bisect'
  )
  parser.add_argument(
    'bad_commit',
    help = 'the known bad (new) commit'
  )
  parser.add_argument(
    'good_commit',
    help = 'the known good (old) commit'
  )
  parser.set_defaults(handler = _bisect_start)

def _bisect_good(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.mark_good()

def _add_parse_good(subparsers):
  parser = subparsers.add_parser(
    'good',
    help = 'mark this git revision as good'
  )
  parser.set_defaults(handler = _bisect_good)

def _bisect_bad(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.mark_bad()

def _add_parse_bad(subparsers):
  parser = subparsers.add_parser(
    'bad',
    help = 'mark this git revision as bad'
  )
  parser.set_defaults(handler = _bisect_bad)

def _bisect_skip(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.skip()

def _add_parse_skip(subparsers):
  parser = subparsers.add_parser(
    'skip',
    help = 'skip this git revision'
  )
  parser.set_defaults(handler = _bisect_skip)

def _bisect_reset(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.reset()

def _add_parse_reset(subparsers):
  parser = subparsers.add_parser(
    'reset',
    help = 'reset the bisect'
  )
  parser.add_argument(
    'commit',
    nargs = '?',
    help = 'the commit to reset to (instead of the original HEAD)'
  )
  parser.set_defaults(handler = _bisect_reset)

def _bisect_view(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.view()

def _add_parse_view(subparsers):
  parser = subparsers.add_parser(
    'visualize',
    aliases = ['view'],
    help = 'visualize the bisect'
  )
  parser.set_defaults(handler = _bisect_view)

def _bisect_replay(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.replay(args.logfile)

def _add_parse_replay(subparsers):
  parser = subparsers.add_parser(
    'replay',
    help = 'replay the bisect'
  )
  parser.add_argument(
    'logfile',
    help = 'the logfile describing what to replay'
  )
  parser.set_defaults(handler = _bisect_replay)

def _bisect_log(args: argparse.Namespace) -> None:
  bisector = MonoRepoBisector(edgutil.find_mono_repo_or_exit())
  bisector.log()

def _add_parse_log(subparsers):
  parser = subparsers.add_parser(
    'log',
    help = 'view the bisect log'
  )
  parser.set_defaults(handler = _bisect_log)

def _parse_args():
  parser = argparse.ArgumentParser(
    description = 'EDG wrapper around git-bisect designed for the mono-repo.'
  )
  parser.set_defaults(handler = lambda args: print('Select a sub-command'))

  subparsers = parser.add_subparsers(help = 'sub-command help')
  _add_parse_start(subparsers)
  _add_parse_good(subparsers)
  _add_parse_bad(subparsers)
  _add_parse_skip(subparsers)
  _add_parse_reset(subparsers)
  _add_parse_view(subparsers)
  _add_parse_replay(subparsers)
  _add_parse_log(subparsers)

  return parser.parse_args()

def main() -> None:
  args = _parse_args()

  try:
    args.handler(args)
  except BisectInProgressException:
    eprint('A git bisect is already in progress, please reset with:')
    eprint('  edg-bisect reset')
    sys.exit(1)
  except NoBisectException:
    eprint('No git bisect in progress, please start one with:')
    eprint('  edg-bisect start')
    sys.exit(1)

main()
