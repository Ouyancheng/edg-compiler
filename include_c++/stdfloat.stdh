/*
stdfloat -- Include file for extended floating-point types ([stdfloat.syn])
*/
#ifndef _STDFLOAT_STDH
#define _STDFLOAT_STDH

#ifndef __cplusplus
 #error -- <stdfloat> header requires C++ mode
#endif /* ifndef __cplusplus */

namespace std {

#if defined(__STDCPP_FLOAT16_T__)
using float16_t = decltype(1.0f16);
#endif /* defined(__STDCPP_FLOAT16_T__) */

#if defined(__STDCPP_FLOAT32_T__)
using float32_t = decltype(1.0f32);
#endif /* defined(__STDCPP_FLOAT32_T__) */

#if defined(__STDCPP_FLOAT64_T__)
using float64_t = decltype(1.0f64);
#endif /* defined(__STDCPP_FLOAT64_T__) */

#if defined(__STDCPP_FLOAT128_T__)
using float128_t = decltype(1.0f128);
#endif /* defined(__STDCPP_FLOAT128_T__) */

#if defined(__STDCPP_BFLOAT16_T__)
using bfloat16_t = decltype(1.0bf16);
#endif /* defined(__STDCPP_BFLOAT16_T__) */

}  /* namespace std */

#ifdef __EDG_IMPLICIT_USING_STD
/* Implicitly include a using directive for the STD namespace when this
   preprocessing flag is TRUE. */
using namespace std;
#endif /* ifdef __EDG_IMPLICIT_USING_STD */

#endif /* STDFLOAT_STDH */

