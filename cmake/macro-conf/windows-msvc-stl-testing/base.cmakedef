# Import the base EDG Windows release configuration
import <windows-msvc-release/base>

# Microsoft uses some defaults for their purposes that we don't want generally
# speaking.
DEFAULT_ADD_MATCH_NOTES=0
DEFAULT_ALLOW_NONSTANDARD_ANONYMOUS_UNIONS=0
DEFAULT_CPPCLI_CPPCX_VERSION=1934
DEFAULT_DISPLAY_ERROR_CONTEXT_ON_CATASTROPHE=1
DEFAULT_EXCEPTIONS_ENABLED=1
DEFAULT_EXPORT_TEMPLATE_ALLOWED=0
DEFAULT_FLOATING_POINT_TEMPLATE_PARAMETERS_ALLOWED=0
DEFAULT_MAX_PENDING_INSTANTIATIONS=500
DEFAULT_MICROSOFT_MODE=0
DEFAULT_MICROSOFT_VERSION=1934
DEFAULT_PASS_STDARG_REFERENCES_TO_GENERATED_CODE=0
DEFAULT_RECORD_FORM_OF_NAME_REFERENCE=1
DEFAULT_REMOVE_UNNEEDED_ENTITIES=0
DEFAULT_RIGHT_SHIFT_CAN_BE_ANGLE_BRACKETS=1
DEFAULT_UNICODE_SOURCE_KIND=usk_utf8

# Configure some va-list options.
BUILTIN_VA_LIST_OVERRIDE_TYPE_NAME="__va_list"
DEFAULT_VA_LIST_IN_STD_NAMESPACE=0
GUARD_MACRO_FOR_VA_LIST="_VA_LIST_DEFINED"

# Microsoft uses a fixed address for memory mapping
USE_MMAP_FOR_MEMORY_REGIONS=1
USE_FIXED_ADDRESS_FOR_MMAP=1
FIXED_ADDRESS_FOR_MMAP=0x25000000

# Misc other settings.
ACCEPT_GNU_CARRIAGE_RETURN_LINE_TERMINATOR=1
ALL_TEMPLATE_INFO_IN_IL=1
ASM_FUNCTION_ALLOWED=0
AUTOMATIC_TEMPLATE_INSTANTIATION=0
COMPILE_MULTIPLE_TRANSLATION_UNITS=0
COROUTINE_ENABLING_POSSIBLE=1
DEFINE_MACRO_WHEN_BOOL_IS_KEYWORD=0
DEFINE_MACRO_WHEN_WCHAR_T_IS_KEYWORD=0
EXPORT_ENABLING_POSSIBLE=0
EXTRA_SOURCE_POSITIONS_IN_IL=1
FAVOR_CONSTANT_RESULT_FOR_NONSTATIC_INIT=0
FUNCTION_PROTOTYPE_INSTANTIATION_DEFERRAL_ALLOWED=0
GNU_EXTENSIONS_ALLOWED=1
GNU_VECTOR_TYPES_ALLOWED=1
HOST_ALLOCATION_INCREMENT=262144
HOST_FP_VALUE_IS_128BIT=1
IDENTIFIER_STRINGS_ALLOW_MULTIBYTE_CHARS=1
IL_SHOULD_BE_WRITTEN_TO_FILE=1
INCLUDE_UNRECOGNIZED_PRAGMAS_IN_IL=1
INSTANTIATION_BY_IMPLICIT_INCLUSION=0
INTEGER_VALUE_REPR_IS_A_HOST_INTEGER=0
LARGE_IL_FILE_SUPPORT=0
LAZY_INITIALIZATION_USES_WEAK_REFERENCES=1
# LOWERING_REMOVES_UNNEEDED_CONSTRUCTIONS_AND_DESTRUCTIONS=0
# LOWER_CLASS_RVALUE_ADJUST=0
# LOWER_STRING_LITERALS_TO_NON_CONST=0
# LOWER_VARIABLE_LENGTH_ARRAYS=0
# LOWER_COMPLEX=0
MACRO_DEFINED_WHEN_CHAR16_T_AND_CHAR32_T_ARE_KEYWORDS="_HAS_CHAR16_T_LANGUAGE_SUPPORT"
MAINTAIN_NEEDED_FLAGS=0
MAX_SIZEOF_LARGEST_INTEGER=16
MINIMAL_INLINING=0
NATIVE_MULTIBYTE_CHARS_SUPPORTED_WITH_UNICODE=0
NEAR_AND_FAR_ALLOWED=0
ONE_INSTANTIATION_PER_OBJECT=0
OPTIMIZE_VIRTUAL_FUNCTION_CALLS=0
RECORD_BIT_FIELD_CONTAINER_OFFSETS_IN_IL=1
STACK_REFERENCED_INCLUDE_DIRECTORIES=1
PRAGMA_DEFINE_TYPE_INFO_IS_REQUIRED=0
PTR_TO_MEMBER_REPR_SUPPORTS_CAST_FROM_VIRTUAL_BASE=1
QUESTION_MARK_CAN_OCCUR_AS_PART_OF_MULTIBYTE_CHAR=0
RECORD_BIT_FIELD_CONTAINER_OFFSETS_IN_IL=0
RECORD_MACROS_IN_IL=1
RECORD_RAW_ASM_OPERAND_DESCRIPTIONS=1
RECORD_TEMPLATE_STRINGS=1
RECORD_UNRECOGNIZED_ATTRIBUTES=1
REFLECTION_ENABLING_POSSIBLE=0
REPRESENT_C11_GENERIC_CONSTRUCT_IN_IL=1
STACK_REFERENCED_INCLUDE_DIRECTORIES=0
UNICODE_VULNERABILITY_DETECTION_SUPPORTED=0
UPC_EXTENSIONS_ALLOWED=0
