# DEBUG=1 is implicit.

USE_EDG_NAMESPACE=0

# Ensure unexpected missing switch cases are diagnosed.
CHECK_SWITCH_DEFAULT_UNEXPECTED=0

# Test version related macros
ADD_CHECKING_PRAGMAS_FOR_INTERNAL_TESTING=1
INSTANTIATE_BEFORE_PCH_CREATION=1
ENABLE_TRANS_UNIT_TEST_MODE=1
INCLUDE_EDG_TEST_PRAGMAS=1
INCLUDE_EDG_TEST_ATTRIBUTES=1
INCLUDE_EDG_TEST_NAMED_ADDRESS_SPACES=1
INCLUDE_EDG_TEST_NAMED_REGISTERS=1
SAME_REPR_INTS_INTERCHANGEABLE_IN_IL=0
ASSIGNMENT_TO_THIS_ALLOWED=0
DEFAULT_ALLOW_ANACHRONISMS=0
CFRONT_GLOBAL_VS_MEMBER_NAME_LOOKUP_BUG=0
CFRONT_2_1_OBJECT_CODE_COMPATIBILITY=0
NEW_CAN_BE_FOLDED_INTO_CTOR=0
MULTIBYTE_CHARS_IN_SOURCE_SUPPORTED=1
USE_OWN_SJIS_MULTIBYTE_CHAR_PROCESSING=0
PRAGMA_WEAK_ALLOWED=1
ASM_FUNCTION_ALLOWED=1
INCLUDE_COMMENTS_IN_ASM_FUNC_BODY=1
TARG_ZERO_WIDTH_BIT_FIELD_AFFECTS_STRUCT_ALIGNMENT=1
MAINTAIN_NEEDED_FLAGS=1
DEFAULT_REMOVE_UNNEEDED_ENTITIES=0
DEFAULT_FRIEND_INJECTION=1
DEFAULT_DISPLAY_ERROR_CONTEXT_ON_CATASTROPHE=1
LOWER_VARIABLE_LENGTH_ARRAYS=0
LOWER_DESIGNATED_INITIALIZERS=1

# Non-Optimized Macros
IL_SHOULD_BE_WRITTEN_TO_FILE=1
TARG_MICROSOFT_BIT_FIELD_ALLOCATION=0
UPC_EXTENSIONS_ALLOWED=1
DEFAULT_SVR4_C_MODE=0
VLA_ALLOWED=1
DEFAULT_VLA_ENABLED=0
DEFAULT_SUN_COMPATIBILITY=0

# Enable extra source positions in the IL.
EXTRA_SOURCE_POSITIONS_IN_IL=1
SEQUENCING_DIAGNOSTICS_ENABLED=1

# Enable recognition of Microsoft attributes for internal versions.
SUPPRESS_MICROSOFT_ATTRIBUTE_PROCESSING=0

# Use the bool type for a_boolean to allow for booleans to better be
# represented in debuggers.
USE_BOOL_FOR_BOOLEAN_IN_CPLUSPLUS=1

# Allow Microsoft extensions (off by default).
import <support/feature/microsoft-extensions/on>
DEFAULT_MICROSOFT_MODE=0

# Allow C++/CLI and C++/CX to be enabled.
import <support/feature/cppcli/on>

# For test versions, eschew the Microsoft approach to predeclaring type_info
# in the global namespace since that doesn't match the EDG run-time support
# library.
MICROSOFT_MODE_TYPE_INFO_IN_NAMESPACE_STD=1
OVERWRITE_FREED_MEM_BLOCKS=1
