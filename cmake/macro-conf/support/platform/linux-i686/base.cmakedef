# Import Base Linux Platform Configuration
import <support/platform/linux/base>
# Import X86-64 Configuration
import <support/arch/i686/base>

# Use linux_x86_64 as the legacy configuration name
LEGACY_TARGET_CONFIGURATION_NAME="linux_i686"

# Import the named win32 target as target configuration #1
import <support/target/win32/base>
TARGET_CONFIGURATION_1=win32
