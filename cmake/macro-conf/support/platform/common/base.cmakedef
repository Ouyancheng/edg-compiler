ASM_FUNCTION_ALLOWED=1
DEFAULT_GNU_COMPATIBILITY=0
DEFAULT_INSTANTIATION_MODE=tim_none
DEFAULT_OUTPUT_MODE=om_text
DEFAULT_INCOGNITO=0
DEFAULT_MICROSOFT_MODE=0
EXTRA_SOURCE_POSITIONS_IN_IL=1
MACRO_INVOCATION_TREE_IN_IL=0
UPC_EXTENSIONS_ALLOWED=1
ABI_COMPATIBILITY_VERSION=99999
DEFAULT_FLOATING_POINT_TEMPLATE_PARAMETERS_ALLOWED=1

# Use the predefined_macros.txt files.
DEFAULT_USE_PREDEFINED_MACRO_FILE=1

# Enable legacy export support.
EXPORT_ENABLING_POSSIBLE=1
DEFAULT_EXPORT_TEMPLATE_ALLOWED=1

# Enable reflection support.
REFLECTION_ENABLING_POSSIBLE=1

# Enable modules support.
DEFAULT_MODULES_ENABLED=1
ASSUME_LITTLE_ENDIAN_IFC_MODULES=1

# The following configuration macros are no longer used, but are kept in this
# file so that git-find-commit will continue to work (because this file may be
# used to compile older versions where the macros are used).
TARG_MINIMUM_PACK_ALIGNMENT_linux_x86_64=1
TARG_MAXIMUM_PACK_ALIGNMENT_linux_x86_64=128
TARG_MINIMUM_PACK_ALIGNMENT_linux_i686=1
TARG_MAXIMUM_PACK_ALIGNMENT_linux_i686=128
TARG_MINIMUM_PACK_ALIGNMENT_win64=1
TARG_MAXIMUM_PACK_ALIGNMENT_win64=128
TARG_MINIMUM_PACK_ALIGNMENT_win32=1
TARG_MAXIMUM_PACK_ALIGNMENT_win32=128
